{
  "compilerOptions": {
    "target":            "ES2020",
    "module":            "commonjs",
    "esModuleInterop":   true,
    "strict":            true,
    "resolveJsonModule": true,
    "outDir":            "./dist",
    "rootDir":           "./",
    "skipLibCheck":      true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "hardhat.config.ts",
    "scripts/**/*.ts",
    "test/**/*.ts",
    "typechain-types/**/*.ts"
  ],
  "files": ["./node_modules/@nomicfoundation/hardhat-toolbox/src/index.ts"]
}
