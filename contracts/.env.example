# ── Deployer ──────────────────────────────────────────────────────────────────
# Private key of the deployer wallet (WITH 0x prefix)
DEPLOYER_PRIVATE_KEY=0x...

# ── Arc Testnet ──────────────────────────────────────────────────────────────
# Default: https://rpc.testnet.arc.network  (override with paid RPC if needed)
ARC_RPC_URL=https://rpc.testnet.arc.network

# ── Fee Recipient ─────────────────────────────────────────────────────────────
# Wallet that receives platform fees (2.5%)
FEE_RECIPIENT=0x...

# ── Gas Reporting ─────────────────────────────────────────────────────────────
REPORT_GAS=false
